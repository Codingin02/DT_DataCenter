{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dt-datacenter:telemetry:1.0",
  "title": "DT_DataCenter environmental telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "device_id",
    "boot_id",
    "seq",
    "sensor_id",
    "asset_id",
    "metric",
    "value",
    "unit",
    "ts",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "site_id": {
      "$ref": "#/$defs/canonical_id"
    },
    "device_id": {
      "$ref": "#/$defs/canonical_id"
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000](?:[^\\u0000]{0,126}[^\\s\\u0000])?$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sensor_id": {
      "$ref": "#/$defs/canonical_id"
    },
    "asset_id": {
      "$ref": "#/$defs/canonical_id"
    },
    "metric": {
      "$ref": "#/$defs/canonical_id"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "quality": {
      "enum": ["good", "degraded", "invalid", "unknown"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "metric": {
          "const": "temperature"
        },
        "unit": {
          "const": "degC"
        }
      }
    },
    {
      "properties": {
        "metric": {
          "const": "humidity"
        },
        "unit": {
          "const": "percent_rh"
        }
      }
    }
  ],
  "$defs": {
    "canonical_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  }
}
