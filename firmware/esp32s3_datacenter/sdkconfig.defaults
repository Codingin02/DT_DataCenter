CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
# CONFIG_ESPTOOLPY_OCT_FLASH is not set
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_DT_SITE_ID="campus-lab"
CONFIG_DT_DEVICE_ID="rack-controller"
CONFIG_DT_SHT31_A_TEMPERATURE_SENSOR_ID="sht31-a-temperature"
CONFIG_DT_SHT31_A_TEMPERATURE_ASSET_ID="sht31-a"
CONFIG_DT_SHT31_A_HUMIDITY_SENSOR_ID="sht31-a-humidity"
CONFIG_DT_SHT31_A_HUMIDITY_ASSET_ID="sht31-a"
CONFIG_DT_SHT31_B_TEMPERATURE_SENSOR_ID="sht31-b-temperature"
CONFIG_DT_SHT31_B_TEMPERATURE_ASSET_ID="sht31-b"
CONFIG_DT_SHT31_B_HUMIDITY_SENSOR_ID="sht31-b-humidity"
CONFIG_DT_SHT31_B_HUMIDITY_ASSET_ID="sht31-b"
CONFIG_DT_ACOUSTIC_RMS_SENSOR_ID="rack-sound-rms"
CONFIG_DT_ACOUSTIC_RMS_ASSET_ID="rack-acoustic"
CONFIG_DT_ACOUSTIC_PEAK_SENSOR_ID="rack-sound-peak"
CONFIG_DT_ACOUSTIC_PEAK_ASSET_ID="rack-acoustic"
CONFIG_DT_SNTP_SERVER="pool.ntp.org"
