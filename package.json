{
  "type": "module",
  "scripts": {
    "backend": "node backend/server.js",
    "backup:database": "node scripts/postgres-backup.js backup",
    "data:acceptance:cleanup": "node scripts/acceptance-data.js cleanup",
    "data:acceptance:backfill": "node scripts/acceptance-data.js backfill",
    "data:acceptance:live": "node scripts/acceptance-data.js live",
    "data:acceptance:prometheus": "node scripts/acceptance-data.js openmetrics",
    "data:acceptance:populate": "node scripts/acceptance-data.js populate",
    "data:acceptance:status": "node scripts/acceptance-data.js status",
    "frontend:build": "vite build frontend",
    "test": "node --test backend/*.test.js frontend/*.test.js scripts/*.test.js",
    "test:database": "psql -X --file database/tests/foundation.sql",
    "test:database:restore": "node scripts/postgres-backup.js verify",
    "lint": "eslint backend frontend scripts/*.js eslint.config.js",
    "format:check": "prettier --check backend frontend scripts/*.js docs/contracts README.md eslint.config.js package.json .prettierrc.json .github/workflows/ci.yml",
    "check": "npm run lint && npm run format:check && npm test && npm run frontend:build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mqtt": "^5.15.2",
    "pg": "^8.23.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "echarts": "6.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "overrides": {
    "sharp": "~0.35.3"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  },
  "private": true
}
