# Template only: set real credentials privately; Docker Desktop Linux containers.
POSTGRES_PASSWORD=
PGPASSWORD=
PGHOST=postgres
PGPORT=5432
PGDATABASE=DT_DataCenter
PGUSER=bagus
PG_BACKUP_FILE=backups/postgresql/DT_DataCenter.dump
PGRESTORE_DATABASE=dt_datacenter_restore_verify
MQTT_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=dt-r1-local-backend
MQTT_USERNAME=dt-datacenter
MQTT_PASSWORD=
MQTT_SESSION_EXPIRY_SECONDS=86400
MQTT_MAX_PAYLOAD_BYTES=65536
SHELLY_MQTT_ID=shellyplugpmg3-48f6eebbf3f4
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
DT_HTTP_BIND_ADDRESS=127.0.0.1
DT_HTTP_PORT=3010
# Loopback by default. Set actual authorized Windows LAN IPv4 for IoT devices.
DT_MQTT_BIND_ADDRESS=127.0.0.1
DT_MQTT_PORT=1883
DT_NGINX_BIND_ADDRESS=0.0.0.0
DT_NGINX_PORT=80
DT_RESTART_POLICY=unless-stopped
DT_POSTGRES_VOLUME=dt_datacenter_postgres-data
# Set URL only after Windows Exporter is installed and NIC verified.
HOST_EXPORTER_URL=
HOST_EXPORTER_PLATFORM=windows
HOST_DEVICE_ID=host-dt-datacenter
HOST_NETWORK_NIC=
