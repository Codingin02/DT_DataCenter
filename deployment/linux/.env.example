# Template only: set real credentials privately. No password is generated.
POSTGRES_PASSWORD=
PGPASSWORD=
PGHOST=postgres
PGPORT=5432
PGDATABASE=DT_DataCenter
PGUSER=bagus
PG_BACKUP_FILE=backups/postgresql/DT_DataCenter.dump
PGRESTORE_DATABASE=dt_datacenter_restore_verify
MQTT_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=dt-r1-local-backend
MQTT_USERNAME=dt-datacenter
MQTT_PASSWORD=
MQTT_SESSION_EXPIRY_SECONDS=86400
MQTT_MAX_PAYLOAD_BYTES=65536
SHELLY_MQTT_ID=shellyplugpmg3-48f6eebbf3f4
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
DT_HTTP_BIND_ADDRESS=127.0.0.1
DT_HTTP_PORT=3010
DT_MQTT_BIND_ADDRESS=192.168.1.167
DT_MQTT_PORT=1883
DT_NGINX_BIND_ADDRESS=0.0.0.0
DT_NGINX_PORT=80
DT_RESTART_POLICY=unless-stopped
DT_POSTGRES_VOLUME=dt_datacenter_postgres-data
HOST_EXPORTER_URL=http://host.docker.internal:9100/metrics
HOST_EXPORTER_PLATFORM=linux
HOST_DEVICE_ID=host-dt-datacenter
# Verify actual NIC before using this template on another host.
HOST_NETWORK_NIC=enp11s0
# Must be reachable from Docker host gateway. Restrict TCP 9100 with host firewall.
DT_EXPORTER_BIND_ADDRESS=0.0.0.0
